        "command": "/function worldradio:summon_boombox"
      }
    },
    {
      "label": {
        "text": "🗑 - Remove Boombox",
        "color": "dark_red",
        "bold": true
      },
      "tooltip": {
        "text": "Remove nearest Boombox within 5 blocks"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:remove_boombox"
      }
    },
    {
      "label": {
        "text": "🎶 + Summon Jukebox",
        "color": "dark_green",
        "bold": true
      },
      "tooltip": {
        "text": "Summon 3D Animated Jukebox console at your position"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:summon_jukebox"
      }
    },
    {
      "label": {
        "text": "🗑 - Remove Jukebox",
        "color": "dark_red",
        "bold": true
      },
      "tooltip": {
        "text": "Remove nearest Jukebox within 5 blocks"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:remove_jukebox"
