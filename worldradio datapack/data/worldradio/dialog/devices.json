      "tooltip": {
        "text": "Return to main Control Hub"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/dialog show @s worldradio:help"
      }
    },
    {
      "label": {
        "text": "🌐 Global Radio",
        "color": "green"
      },
      "tooltip": {
        "text": "Go to Global Radio controls"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/dialog show @s worldradio:global"
      }
