{
  "type": "minecraft:multi_action",
  "title": {
    "text": "📻 WorldRadio Control Panel",
    "color": "green",
    "bold": true
  },
  "body": [],
  "inputs": [
    {
      "type": "minecraft:number_range",
      "key": "radius",
      "label": "Radius: ",
      "start": 5,
      "end": 500,
      "step": 5,
      "initial": 20,
      "width": 310
    },
    {
      "type": "minecraft:text",
      "key": "song",
      "label": "Song: ",
      "initial": "",
      "width": 310
    }
  ],
  "columns": 2,
  "pause": false,
  "after_action": "close",
  "can_close_with_escape": true,
  "actions": [
    {
      "label": {
        "text": "📏 Apply Radius",
        "color": "light_purple",
        "bold": true
      },
      "tooltip": {
        "text": "Save and apply slider radius for all Jukebox zones"
      },
      "width": 150,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function worldradio:jukebox/set_radius {radius:$(radius)}"
      }
    },
    {
      "label": {
        "text": "▶ Play Custom Song",
        "color": "green",
        "bold": true
      },
      "tooltip": {
        "text": "Play the song entered in the text box globally"
      },
      "width": 150,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function worldradio:radio/play_custom {song:$(song)}"
      }
    },
    {
      "label": {
        "text": "🌐 ▶ Global Play",
        "color": "green",
        "bold": true
      },
      "tooltip": {
        "text": "[Global Radio] Start playback on speakers OUTSIDE Jukebox zones"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/play"
      }
    },
    {
      "label": {
        "text": "🌐 ⏹ Global Stop",
        "color": "red",
        "bold": true
      },
      "tooltip": {
        "text": "[Global Radio] Stop playback on outside speakers"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/stop"
      }
    },
    {
      "label": {
        "text": "🌐 ⏸ Global Pause",
        "color": "yellow",
        "bold": true
      },
      "tooltip": {
        "text": "[Global Radio] Pause playback on outside speakers"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/pause"
      }
    },
    {
      "label": {
        "text": "🌐 🔀 Global Shuffle",
        "color": "gold",
        "bold": true
      },
      "tooltip": {
        "text": "[Global Radio] Jump to random song on outside speakers"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/shuffle"
      }
    },
    {
      "label": {
        "text": "🌐 ⏮ Global Prev",
        "color": "blue",
        "bold": true
      },
      "tooltip": {
        "text": "[Global Radio] Previous track on outside speakers"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/previous"
      }
    },
    {
      "label": {
        "text": "🌐 ⏭ Global Next",
        "color": "aqua",
        "bold": true
      },
      "tooltip": {
        "text": "[Global Radio] Next track on outside speakers"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/next"
      }
    },
    {
      "label": {
        "text": "🎶 ▶ Play Jukeboxes",
        "color": "green",
        "bold": true
      },
      "tooltip": {
        "text": "[Jukebox Zones] Start playback across all stopped Jukebox zones"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:jukebox/control/play"
      }
    },
    {
      "label": {
        "text": "🎶 ⏹ Stop Jukeboxes",
        "color": "red",
        "bold": true
      },
      "tooltip": {
        "text": "[Jukebox Zones] Stop playback across all active Jukebox zones"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:jukebox/control/stop"
      }
    },
    {
      "label": {
        "text": "🎶 ⏮ Prev Track",
        "color": "blue",
        "bold": true
      },
      "tooltip": {
        "text": "[Jukebox Zones] Switch to previous song in Jukebox zones"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:jukebox/control/prev"
      }
    },
    {
      "label": {
        "text": "🎶 ⏭ Next Track",
        "color": "aqua",
        "bold": true
      },
      "tooltip": {
        "text": "[Jukebox Zones] Switch to next song in Jukebox zones"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:jukebox/control/next"
      }
    },
    {
      "label": {
        "text": "🔄 Global Auto-Play",
        "color": "dark_purple",
        "bold": true
      },
      "tooltip": {
        "text": "[Global Radio] Toggle: Sequential vs Shuffle on finish"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/toggle_shuffle"
      }
    },
    {
      "label": {
        "text": "🔀 Jukebox Shuffle",
        "color": "gold",
        "bold": true
      },
      "tooltip": {
        "text": "[Jukebox Zones] Toggle: Sequential vs Shuffle on track finish"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:jukebox/toggle_shuffle"
      }
    },
    {
      "label": {
        "text": "📢 Notifications",
        "color": "white",
        "bold": true
      },
      "tooltip": {
        "text": "[Settings] Toggle: Both / Actionbar / Chat / Silent"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/toggle_announce"
      }
    },
    {
      "label": {
        "text": "ℹ System Status",
        "color": "gray",
        "bold": true
      },
      "tooltip": {
        "text": "[Diagnostics] Print full system status in chat"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:radio/status"
      }
    },
    {
      "label": {
        "text": "📻 + Boombox",
        "color": "dark_green",
        "bold": true
      },
      "tooltip": {
        "text": "[Devices] Summon 3D Boombox speaker at feet"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:summon_boombox"
      }
    },
    {
      "label": {
        "text": "🗑 - Boombox",
        "color": "dark_red",
        "bold": true
      },
      "tooltip": {
        "text": "[Devices] Remove nearest Boombox within 5 blocks"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:remove_boombox"
      }
    },
    {
      "label": {
        "text": "🎶 + Jukebox",
        "color": "dark_green",
        "bold": true
      },
      "tooltip": {
        "text": "[Devices] Summon 3D Animated Jukebox console at feet"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:summon_jukebox"
      }
    },
    {
      "label": {
        "text": "🗑 - Jukebox",
        "color": "dark_red",
        "bold": true
      },
      "tooltip": {
        "text": "[Devices] Remove nearest Jukebox within 5 blocks"
      },
      "width": 150,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:remove_jukebox"
      }
    },
    {
      "label": {
        "text": "🔄 Reset Everything",
        "color": "red",
        "bold": true
      },
      "tooltip": {
        "text": "[Reset] Stop all playback, clear displays, and restore defaults"
      },
      "width": 310,
      "action": {
        "type": "run_command",
        "command": "/function worldradio:reset"
      }
    }
  ]
}
