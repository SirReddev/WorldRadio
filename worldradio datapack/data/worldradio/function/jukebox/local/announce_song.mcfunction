$execute at @s if score #announce_mode worldradio.data matches 0..1 if score @s worldradio.jb_song matches 5 as @a[distance=..$(radius)] run title @s actionbar ["",{"text":"Now Playing: ","color":"gray"},{"text":"Gourd Dance","color":"aqua","bold":true}]
$execute at @s if score #announce_mode worldradio.data matches 0..1 if score @s worldradio.jb_song matches 6 as @a[distance=..$(radius)] run title @s actionbar ["",{"text":"Now Playing: ","color":"gray"},{"text":"Midnight Mystery","color":"aqua","bold":true}]
