# WorldRadio - Announce Jukebox Song Actionbar & Chat (Macro)
# Actionbar Notification (0 = Both, 1 = Actionbar Only)
$execute at @s if score #announce_mode worldradio.data matches 0..1 if score @s worldradio.jb_song matches 1 as @a[distance=..$(radius)] run title @s actionbar ["",{"text":"Now Playing: ","color":"gray"},{"text":"Bat Cave","color":"aqua","bold":true}]
$execute at @s if score #announce_mode worldradio.data matches 0..1 if score @s worldradio.jb_song matches 2 as @a[distance=..$(radius)] run title @s actionbar ["",{"text":"Now Playing: ","color":"gray"},{"text":"Celebrawl","color":"aqua","bold":true}]
$execute at @s if score #announce_mode worldradio.data matches 0..1 if score @s worldradio.jb_song matches 3 as @a[distance=..$(radius)] run title @s actionbar ["",{"text":"Now Playing: ","color":"gray"},{"text":"Creaking Tree","color":"aqua","bold":true}]
